MONITOR_HOST=127.0.0.1
MONITOR_PORT=8080
MONITOR_ADMIN_USERNAME=admin
MONITOR_ADMIN_PASSWORD=040712
MONITOR_PUBLIC_AGENT_URL=wss://192.168.10.10:8443/ws/agent
MONITOR_AGENT_SHARED_SECRET=replace-with-a-long-random-value
MONITOR_ALLOW_INSECURE_AGENTS=false
MONITOR_ROBOT_COMMAND=/opt/arm_app/bin/arm_app
MONITOR_COLLECTION_COMMAND=rollio collect --config /userdata/rollio_config/config-cart-3-armmes-g2t-observer.toml
MONITOR_SDK_MOTOR_COMMAND=arm-p7-sdk examples run airbot_example_get_arm_motor_states
MONITOR_SDK_JOINT_COMMAND=arm-p7-sdk examples run airbot_example_get_arm_joint_states
MONITOR_SDK_EEF_MOTOR_COMMAND=arm-p7-sdk examples run airbot_example_get_eef_motor_states
MONITOR_ROBOT_ZERO_COMMAND=arm-p7-sdk examples run airbot_example_return_zero --host {ip} --port 50071
MONITOR_STATE_RESET_COMMAND=curl -s -X POST http://127.0.0.1:9090/api/fsm/command -H 'Content-Type: application/json' -d '{"command":"abort"}'
MONITOR_TASK_OPEN_COMMAND=iox2-cabinet-hinge-door-drawer station hinge_door_drawer task open category drawer --run --auto --repeat-count 0 --recording-enabled
MONITOR_TASK_CLOSE_COMMAND=iox2-cabinet-hinge-door-drawer station hinge_door_drawer task close category drawer --run --auto --repeat-count 0 --recording-enabled
MONITOR_COMMAND_WORKDIR=/var/log/airbot
MONITOR_LOG_PATHS=/userdata/storage/arm_app/last/log/arm_app.log
MONITOR_TEMPERATURE_WARNING_C=70
MONITOR_TEMPERATURE_CRITICAL_C=80
MONITOR_SMTP_HOST=smtp.example.com
MONITOR_SMTP_PORT=465
MONITOR_SMTP_USERNAME=monitor@example.com
MONITOR_SMTP_PASSWORD=replace-me
MONITOR_SMTP_FROM=monitor@example.com
MONITOR_ALERT_EMAIL=operator@example.com
