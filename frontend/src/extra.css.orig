.special-controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 10px;
}
.special-controls button {
  font-size: 11px;
  background: #f6f3ff;
  border-color: #ded5fb;
  color: #704fc4;
}
.special-controls button:last-child {
  background: #eef7ff;
  border-color: #d5e8fa;
  color: #3976aa;
}
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  padding: 12px;
  border-top: 1px solid #e8ebf1;
  font-size: 11px;
  color: #788296;
}
.station-pagination{display:flex;justify-content:center;align-items:center;gap:12px;padding:17px 0;color:#7b8598;font-size:11px}.station-pagination button{font-size:10px;padding:7px 11px}
.agent-status{display:flex;align-items:center;gap:6px;margin-top:12px;padding:7px 9px;border-radius:7px;background:#f6f7f9;color:#7e8798;font-size:9px}.agent-status>span{width:6px;height:6px;border-radius:50%;background:#a7afbd}.agent-status.on>span{background:#17b26a}.agent-status.on b{color:#15965a}.agent-status em{font-style:normal;margin-left:auto;max-width:62%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#929aaa}
.modal-actions.split{display:grid;grid-template-columns:auto 1fr auto auto}.modal-actions .danger{color:#d74742;border-color:#f0c5c3;background:#fff7f7}
.terminal{margin-top:12px;border-radius:9px;background:#111827;color:#dce3ef;overflow:hidden}.terminal header{display:flex;justify-content:space-between;padding:9px 11px;background:#1b2536;font-size:11px}.terminal header small{color:#8490a4}.terminal pre{min-height:68px;max-height:180px;overflow:auto;margin:0;padding:10px;font:10px/1.5 ui-monospace,monospace;white-space:pre-wrap}.terminal form{display:flex;align-items:center;border-top:1px solid #2c3749;padding:7px 9px;gap:7px}.terminal form span{color:#70d59b}.terminal input{flex:1;background:transparent;border:0;outline:0;color:#fff;font:11px ui-monospace,monospace}.terminal button{background:#334155;border:0;color:#dce3ef;font-size:10px;padding:6px 10px}
.station-file-group{border:1px solid #e5e9f0;border-radius:9px;margin:10px 0 14px;overflow:hidden}.station-file-group>header{display:flex;align-items:center;justify-content:space-between;background:#f7f9fc;padding:10px 12px}.station-file-group>header div{display:grid;gap:3px}.station-file-group>header strong{font-size:12px}.station-file-group>header small{font-size:10px;color:#8b95a8}.station-file-group>header>span{flex:none;font-size:9px;color:#667085;background:#fff;border:1px solid #e1e5ec;border-radius:10px;padding:3px 7px}.station-file{display:flex;align-items:center;border-top:1px solid #edf0f4;padding:9px 12px}.station-file>svg{color:#8590a4;margin-right:10px}
.log-station-switcher{display:flex;gap:7px;align-items:center;overflow-x:auto;padding:12px 16px;border-bottom:1px solid #e8ebf1;background:#f8faff}.log-station-switcher button{flex:none;font-size:10px;padding:7px 10px}.log-station-switcher button.active{color:#315fd6;border-color:#8ca8f2;background:#edf2ff}.log-station-switcher button span{width:6px;height:6px;border-radius:50%;background:#aab1bf}.log-station-switcher button span.online{background:#17b26a}.file-list-head{display:flex!important;align-items:center!important;justify-content:space-between;border:0!important;padding:0 0 10px!important}.file-list-head>div{display:flex;align-items:center;gap:10px}.file-list-head h3{margin:0}.file-list-head button{font-size:10px;padding:7px 10px}.file-list-head button.danger{color:#d74742;border-color:#efc6c4;background:#fff7f7}.file-check{display:inline-flex;align-items:center;gap:5px;color:#667085;font-size:10px;white-space:nowrap}.file-check input{accent-color:#4c72e8}.station-file>.file-check{margin-right:9px}.station-file>.file-check+svg{margin-right:10px}.data-row{justify-content:space-between;gap:12px}.data-row .eef-temperature{color:#d97706}.eef-temp-grid>div{background:#fff8eb}.eef-temp-grid svg{color:#d97706}

.alarm-list>.alarm-actions{display:flex;align-items:center;gap:10px;padding:13px 16px;background:#f8faff;border-bottom:1px solid #e5e9f0}.alarm-actions>span{flex:1}.alarm-actions button{font-size:10px}.alarm-actions button.danger{color:#d74742;border-color:#efc6c4;background:#fff7f7}.alarm-check{display:inline-flex;align-items:center;gap:5px;font-size:10px;color:#667085}.alarm-check input{accent-color:#4c72e8}.alarm-select{flex:none}.alarm-list>div:not(.alarm-actions)>div:nth-child(3){flex:1}.alarm-list>div:not(.alarm-actions)>.alarm-icon{flex:none}

.station-alarm-group{margin:14px 16px;border:1px solid #e3e7ee;border-radius:10px;overflow:hidden}.station-alarm-group>header{display:flex;align-items:center;gap:10px;padding:0 13px;background:#f7f9fc}.alarm-group-toggle{min-width:0;flex:1;display:flex;align-items:center;gap:10px;padding:11px 0;border:0;border-radius:0;background:transparent;text-align:left}.alarm-group-toggle:hover:not(:disabled){border:0;background:transparent}.alarm-group-toggle>div{display:grid;gap:2px}.alarm-group-toggle strong{font-size:12px;color:#172033}.alarm-group-toggle small{font-size:10px;color:#8b95a8}.alarm-group-toggle>span{margin-left:auto;font-size:9px;color:#667085;background:#fff;border:1px solid #e1e5ec;border-radius:10px;padding:3px 7px;white-space:nowrap}.alarm-group-toggle>svg{width:16px;flex:none;color:#8490a4;transition:transform .18s}.alarm-group-toggle[aria-expanded="true"]>svg{transform:rotate(90deg)}.alarm-group-content{border-top:1px solid #edf0f4}.alarm-row{display:flex;align-items:center;gap:14px;padding:15px 13px;border-top:1px solid #edf0f4}.alarm-group-content>.alarm-row:first-child{border-top:0}.alarm-row.acknowledged,.alarm-row.recovered{opacity:.58}.alarm-row>div:nth-child(3){flex:1}.alarm-row>.alarm-icon{flex:none}

.log-source-filter{display:flex;gap:5px;padding:3px;background:#eef2f8;border-radius:9px}.log-source-filter button{border:0;background:transparent;padding:6px 9px;font-size:10px}.log-source-filter button.active{background:#fff;color:#315fd6;box-shadow:0 1px 3px #1720331a}.log-source-filter button svg{width:14px}.toolbar .danger{color:#d74742;border-color:#efc6c4;background:#fff7f7;font-size:10px;padding:7px 10px}

main{max-width:none}
main>header,main>.panel,main>.welcome-dashboard,main>.metrics,main>.section-title,main>.station-grid,main>.station-pagination{width:min(100%,1500px);margin-left:auto;margin-right:auto}
.welcome-main{padding:20px 22px 34px}
.welcome-main>header,.welcome-main>.welcome-dashboard{width:100%;max-width:none}
.welcome-main>header{margin-bottom:16px}
.logout{margin-top:10px;border:0;color:#7b8496;font-size:11px}
.login-page{min-height:100vh;display:grid;grid-template-columns:minmax(480px,1.2fr) minmax(420px,.8fr);background:#f7f9fd}
.login-visual{position:relative;overflow:hidden;padding:10vh 9vw;background:linear-gradient(145deg,#17285d,#315fd6 58%,#6b5bea);color:#fff}
.login-visual:before,.login-visual:after{content:"";position:absolute;border:1px solid #ffffff2b;border-radius:50%;width:520px;height:520px;right:-180px;bottom:-220px}.login-visual:after{width:330px;height:330px;right:-70px;bottom:-130px}
.login-visual .brand-mark{background:#ffffff1f;box-shadow:none;margin-bottom:45px}.login-visual h1{font-size:34px;letter-spacing:.03em}.login-visual p{margin-top:14px;color:#dce6ff;font-size:14px}
.login-orbits{position:absolute;width:240px;height:240px;right:12%;top:40%;border:1px solid #ffffff35;border-radius:50%;display:grid;place-items:center}.login-orbits:before{content:"";position:absolute;width:145px;height:145px;border:1px solid #ffffff3b;border-radius:50%}.login-orbits svg{width:55px;height:55px}.login-orbits span{position:absolute;width:13px;height:13px;background:#60e6aa;border-radius:50%;top:18px;left:52px;box-shadow:0 0 24px #60e6aa}.login-orbits span:nth-child(2){background:#ffd166;top:auto;left:auto;right:2px;bottom:65px}
.login-card{width:390px;margin:auto;background:#fff;border:1px solid #e4e8f1;border-radius:18px;padding:38px;box-shadow:0 24px 70px #22336616}.login-card>small{color:#4c72e8;font-weight:700;letter-spacing:.16em}.login-card h2{font-size:25px;margin-top:11px}.login-card>p{font-size:12px;color:#8a94a8;margin:7px 0 25px}.login-card label{display:grid;gap:7px;font-size:11px;color:#5e687c;margin:14px 0}.login-card input{border:1px solid #dce2ec;border-radius:9px;padding:11px;outline:0}.login-card input:focus{border-color:#5679e8;box-shadow:0 0 0 3px #5679e818}.login-card>.primary{width:100%;margin-top:16px;padding:11px}.login-card>em{display:block;text-align:center;font-size:9px;color:#a0a8b6;margin-top:14px;font-style:normal}
.welcome-dashboard{display:grid;gap:18px}.welcome-hero{min-height:250px;border-radius:20px;padding:38px 44px;display:flex;align-items:center;overflow:hidden;background:linear-gradient(125deg,#192960,#315fd6 65%,#725ce7);color:#fff;box-shadow:0 14px 35px #315fd629}.welcome-hero>div:first-child{flex:1}.welcome-hero span{font-size:10px;letter-spacing:.18em;color:#bcd0ff}.welcome-hero h2{font-size:29px;margin:12px 0}.welcome-hero p{color:#dbe5ff;font-size:13px}.welcome-hero>div>div{display:flex;gap:9px;margin-top:25px}.welcome-hero button:not(.primary){background:#ffffff14;border-color:#ffffff3d;color:#fff}.hero-pulse{width:180px;height:180px;border:1px solid #ffffff38;border-radius:50%;display:grid;place-items:center;position:relative;margin-right:40px}.hero-pulse:before{content:"";position:absolute;inset:28px;border:1px solid #ffffff40;border-radius:50%}.hero-pulse svg{width:50px;height:50px}.hero-pulse i{position:absolute;width:12px;height:12px;background:#64e5ad;border-radius:50%;top:12px;left:38px;box-shadow:0 0 18px #64e5ad}.hero-pulse i:last-child{background:#ffd166;top:auto;left:auto;bottom:22px;right:4px}
.welcome-charts{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:16px}.welcome-charts article{min-height:230px;background:#fff;border:1px solid #e3e7ef;border-radius:15px;padding:20px;box-shadow:0 3px 12px #24324c08}.welcome-charts article>header{display:flex;justify-content:space-between;align-items:center;color:#40506a}.welcome-charts article>header svg{color:#5879df}.donut{--percent:calc(var(--value)*1%);width:140px;height:140px;border-radius:50%;margin:22px auto 0;background:conic-gradient(#4c72e8 var(--percent),#edf1f7 0);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative}.donut:before{content:"";position:absolute;inset:14px;background:#fff;border-radius:50%}.donut b,.donut small{position:relative}.donut b{font-size:25px}.donut small{font-size:9px;color:#8a94a6;margin-top:3px}.chart-bar{margin-top:26px}.chart-bar label{display:flex;justify-content:space-between;font-size:10px;margin-bottom:7px}.chart-bar label b{font-weight:600}.chart-bar>i{height:8px;background:#edf1f6;border-radius:5px;overflow:hidden;display:block}.chart-bar em{height:100%;display:block;border-radius:5px}.alarm-summary{height:125px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#19a466}.alarm-summary.hot{color:#e34f49}.alarm-summary b{font-size:45px}.alarm-summary span{font-size:10px}.welcome-charts article>button{width:100%;font-size:10px}
.scrim.centered{justify-content:center;align-items:center}.command-error-modal{width:460px;background:#fff;border-radius:16px;padding:30px;text-align:center;box-shadow:0 25px 70px #17203338}.error-symbol{width:52px;height:52px;margin:0 auto 14px;display:grid;place-items:center;border-radius:50%;background:#feebea;color:#df4944}.error-symbol svg{width:25px}.command-error-modal h2{font-size:19px}.command-error-modal>p{font-size:11px;color:#8a93a5;margin-top:6px}.command-error-modal pre{text-align:left;white-space:pre-wrap;background:#fff3f2;color:#b83d39;border-radius:9px;padding:13px;font:11px/1.5 ui-monospace,monospace;margin:20px 0}.command-error-modal>div:last-child{display:flex;justify-content:center;gap:9px}
.welcome-hero{min-height:300px;border-radius:22px;padding:34px 48px;position:relative;background:radial-gradient(circle at 82% 16%,#7e69f080,transparent 27%),linear-gradient(125deg,#172557,#2e5dcf 64%,#6655db);box-shadow:0 18px 42px #315fd62b}.welcome-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:30px 30px;mask-image:linear-gradient(90deg,transparent 35%,#000)}
.welcome-copy{position:relative;z-index:1;flex:1}.hero-status{width:max-content;display:flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid #ffffff24;border-radius:20px;background:#ffffff12;color:#e8eeff;font-size:10px}.hero-status i{width:7px;height:7px;border-radius:50%;background:#63e3aa;box-shadow:0 0 0 4px #63e3aa1f}.hero-status.warning i{background:#ff887f;box-shadow:0 0 0 4px #ff887f20}.hero-status.partial i{background:#ffd166;box-shadow:0 0 0 4px #ffd16620}
.hero-eyebrow{display:block;margin-top:19px;font-size:9px!important;letter-spacing:.2em!important;color:#bcd0ff}.welcome-hero h2{font-size:30px;margin:9px 0}.welcome-hero p{color:#dbe5ff;font-size:12px}
.hero-metrics{display:flex!important;gap:0!important;margin-top:23px!important}.hero-metrics>div{min-width:108px;padding-right:26px;margin-right:26px;border-right:1px solid #ffffff25}.hero-metrics>div:last-child{border:0}.hero-metrics strong,.hero-metrics span{display:block}.hero-metrics strong{font-size:24px;line-height:1}.hero-metrics span{margin-top:6px;color:#c6d5f8;font-size:9px;letter-spacing:0}.hero-metrics .attention strong{color:#ffaaa4}
.hero-actions{display:flex!important;gap:9px!important;margin-top:23px!important}.welcome-hero button{padding:9px 14px}.welcome-hero .primary{background:#fff;border-color:#fff;color:#315fd6;box-shadow:0 7px 18px #1725572e}.welcome-hero .primary:hover:not(:disabled){background:#f4f7ff;border-color:#f4f7ff}.welcome-hero button:not(.primary){background:#ffffff12;border-color:#ffffff35;color:#fff}.welcome-hero button:not(.primary):hover{background:#ffffff1e;border-color:#ffffff52}
.hero-radar{flex:none;width:210px;height:210px;margin:0 48px 0 70px;border:1px solid #ffffff2f;border-radius:50%;display:grid;place-items:center;position:relative;box-shadow:inset 0 0 40px #b9caff0b}.hero-radar:before,.hero-radar:after{content:"";position:absolute;border:1px solid #ffffff32;border-radius:50%}.hero-radar:before{inset:31px}.hero-radar:after{inset:66px}.radar-core{width:76px;height:76px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;background:#ffffff14;border:1px solid #ffffff2c;box-shadow:0 0 32px #9db4ff25;z-index:1}.radar-core svg{width:27px;height:27px}.radar-core span{font-size:8px;color:#d6e2ff}.hero-radar i{position:absolute;width:10px;height:10px;background:#63e3aa;border:2px solid #ffffffb8;border-radius:50%;top:16px;left:50px;box-shadow:0 0 18px #63e3aa}.hero-radar i:nth-of-type(2){width:8px;height:8px;background:#ffd166;top:auto;left:auto;right:2px;bottom:55px;box-shadow:0 0 15px #ffd166}.hero-radar i:nth-of-type(3){width:7px;height:7px;background:#9eb9ff;top:85px;left:26px;box-shadow:0 0 14px #9eb9ff}
.welcome-charts{grid-template-columns:1fr 1.35fr 1fr}.welcome-charts article{min-height:245px;border-radius:16px;padding:20px 22px;box-shadow:0 4px 16px #24324c08;transition:transform .18s,box-shadow .18s}.welcome-charts article:hover{transform:translateY(-2px);box-shadow:0 10px 26px #24324c0d}.welcome-charts article>header>div{display:grid;gap:4px}.welcome-charts article>header strong{font-size:12px}.welcome-charts article>header small{font-size:9px;color:#98a1b2}.card-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center}.card-icon svg{width:17px}.card-icon.blue{color:#4c72e8;background:#edf2ff}.card-icon.purple{color:#7357e8;background:#f1edff}.card-icon.red{color:#df514c;background:#fff0ef}
.donut{width:130px;height:130px;margin-top:14px}.donut:before{inset:13px;box-shadow:inset 0 0 0 1px #f1f3f7}.donut b{font-size:24px}.status-legend{display:flex;justify-content:center;gap:20px;margin-top:12px;color:#7f899b;font-size:9px}.status-legend span{display:flex;align-items:center;gap:5px}.status-legend i{width:7px;height:7px;border-radius:50%;background:#cfd5df}.status-legend i.online{background:#4c72e8}.chart-bar{margin-top:25px}.chart-bar label span{color:#687386}.chart-bar em{transition:width .35s}
.alarm-card.has-alarm{border-color:#f1d4d2}.alarm-summary{height:127px}.alarm-summary b{font-size:43px;line-height:1}.alarm-summary span{margin-top:7px;font-weight:600}.alarm-summary small{font-size:8px;margin-top:5px;color:#9aa2b1}.welcome-charts article>button{background:#f8faff;border-color:#e5eaf4}.alarm-card.has-alarm>button{color:#d94a45;background:#fff7f6;border-color:#f2d3d1}
.welcome-copy>.hero-status{margin-top:0;gap:7px}.hero-radar>.radar-core{margin-top:0;gap:4px}
.welcome-stations{margin-top:2px}.welcome-stations>header{display:flex;align-items:end;justify-content:space-between;margin:0 2px 12px}.welcome-stations>header h3{font-size:14px}.welcome-stations>header p{font-size:9px;color:#929bad;margin-top:4px}.welcome-stations>header button{border:0;background:transparent;color:#4c72e8;font-size:9px;padding:5px}
.welcome-station-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.welcome-station-grid>article{min-width:0;background:#fff;border:1px solid #e3e7ef;border-radius:13px;padding:13px 14px;box-shadow:0 3px 12px #24324c07;transition:border-color .18s,transform .18s}.welcome-station-grid>article:hover{transform:translateY(-2px);border-color:#cdd7ec}.welcome-station-grid>article.offline{background:#fafbfc}
.welcome-station-grid article>header{display:flex;align-items:center;gap:9px}.welcome-station-mark{width:31px;height:31px;flex:none;display:grid;place-items:center;border-radius:9px;background:#edf2ff;color:#4c72e8}.welcome-station-mark svg{width:16px}.welcome-station-grid header>div{min-width:0}.welcome-station-grid header strong,.welcome-station-grid header small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.welcome-station-grid header strong{font-size:10px}.welcome-station-grid header small{font-size:8px;color:#929bad;margin-top:3px}
.station-signal{margin-left:auto;display:flex;align-items:center;gap:4px;flex:none;padding:4px 6px;border-radius:10px;background:#f0f2f5;color:#8b94a5;font-size:8px}.station-signal i{width:5px;height:5px;border-radius:50%;background:#aab1bd}.station-signal.on{color:#158b58;background:#eaf8f1}.station-signal.on i{background:#18ae68;box-shadow:0 0 0 3px #18ae6814}
.welcome-processes{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:12px 0 10px}.welcome-processes span{min-width:0;display:flex;align-items:center;gap:4px;padding:7px;background:#f6f8fb;border-radius:7px;color:#7e8798;font-size:8px;white-space:nowrap}.welcome-processes i{width:5px;height:5px;flex:none;border-radius:50%;background:#aeb5c1}.welcome-processes span.running{color:#138c57;background:#eef9f3}.welcome-processes span.running i{background:#18ae68}.welcome-processes span.failed{color:#d84944;background:#fff1f0}.welcome-processes span.failed i{background:#e6534e}
.welcome-station-grid article>footer{display:flex;align-items:center;padding-top:9px;border-top:1px solid #eef0f4;color:#8992a3;font-size:8px}.welcome-station-grid footer b{color:#495469;margin-left:2px}.welcome-station-grid footer>span:last-child{margin-left:auto;display:flex;align-items:center;gap:3px}.welcome-station-grid footer svg{width:11px;height:11px}.station-alert{color:#df4e49}.station-ok{color:#15935a}.welcome-stations-empty{grid-column:1/-1;min-height:115px;border:1px dashed #ccd4e1;border-radius:13px;display:flex;align-items:center;justify-content:center;gap:8px;color:#8b94a5;font-size:10px}.welcome-stations-empty svg{width:20px}
@media(max-width:1350px){.welcome-station-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:1100px){.hero-radar{display:none}}
@media(max-width:1100px){.login-page{grid-template-columns:1fr}.login-visual{display:none}.welcome-charts{grid-template-columns:1fr}.hero-pulse{display:none}}
@media(max-width:1250px){.welcome-main{padding:20px 18px 32px}}

.login-loading{min-height:100vh;display:flex;align-items:center;justify-content:center;gap:10px;color:#667085;background:#f4f6fa}.access-action{display:grid;justify-items:center;gap:4px}.access-action button{width:100%}.access-action .remote{color:#147d54;border-color:#bde6d2;background:#f1fbf6}.access-action .internet{color:#8a4b16;border-color:#efcfad;background:#fff8ed}.network-help{display:inline-flex;align-items:center;gap:4px;color:#65718a;text-decoration:none;font-size:9px;white-space:nowrap}.network-help:hover{color:#315fd6}.network-help svg{width:12px;height:12px}.network-modal .error-symbol.success{background:#e5f8ee;color:#16a36a}.network-modal>a{display:block;margin:-8px 0 20px;padding:12px;border-radius:8px;background:#edf3ff;color:#315fd6;font-weight:700;text-decoration:none}.network-modal>div:last-child{margin-top:12px}.network-modal .help-button{display:inline-flex;align-items:center;padding:9px 13px;border:1px solid #dfe3eb;border-radius:8px;color:#485268;text-decoration:none;font-size:11px}

.card-actions .card-link{border:1px solid #dfe3eb;background:#fff;color:#485268;padding:7px 9px;border-radius:8px;text-decoration:none;display:inline-flex;align-items:center;gap:5px;font-size:10px;white-space:nowrap}.card-actions .card-link svg{width:14px}.card-actions .card-link.acquisition{color:#147d54;border-color:#bde6d2;background:#f1fbf6}.external-tools{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.external-tools a{display:flex;align-items:center;justify-content:center;gap:7px;padding:9px;border:1px solid #dfe5ef;border-radius:8px;text-decoration:none;color:#365fcf;background:#f7f9ff;font-size:10px}.external-tools a:first-child{color:#147d54;background:#f1fbf6;border-color:#c5e9d7}.external-tools svg{width:15px}.fsm-monitor{width:min(100%,1500px);height:calc(100vh - 145px);margin:0 auto;background:#fff;border:1px solid #e1e5ed;border-radius:14px;overflow:hidden;display:flex;flex-direction:column}.fsm-monitor>header{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid #e8ebf1}.fsm-monitor>header>div{flex:1}.fsm-monitor h2{font-size:15px}.fsm-monitor p{font-size:10px;color:#8b94a6;margin-top:4px}.fsm-monitor select{min-width:250px;border:1px solid #dce2eb;border-radius:8px;padding:8px}.fsm-monitor>header>a{font-size:10px;color:#315fd6;text-decoration:none;border:1px solid #cdd8f6;border-radius:8px;padding:8px 10px}.fsm-monitor iframe{flex:1;width:100%;border:0;background:#0f1117}

.analytics-page{display:grid;gap:16px}.analytics-intro{display:flex;align-items:end;justify-content:space-between;background:linear-gradient(120deg,#172b57,#315db2);color:#fff;border-radius:16px;padding:23px 26px}.analytics-intro h2{font-size:21px;margin-top:7px}.analytics-intro p{font-size:11px;color:#c7d6f7;margin-top:7px}.analytics-updated{display:flex;align-items:center;gap:7px;font-size:10px;color:#d5e3ff}.analytics-updated i{width:7px;height:7px;border-radius:50%;background:#45d18b;box-shadow:0 0 0 4px #45d18b35}.analytics-metrics{margin:0}.analytics-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.analysis-card{background:#fff;border:1px solid #e3e7ef;border-radius:15px;padding:20px;box-shadow:0 3px 12px #24324c08}.analysis-card>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.analysis-card>header strong{display:block;font-size:13px;color:#40506a}.analysis-card>header small{display:block;color:#98a1b2;font-size:9px;margin-top:4px}.analysis-card>header>span:last-child{font-size:10px;color:#8d96a8}.analysis-stat{margin:18px 0}.analysis-stat>span{font-size:10px;color:#687386}.analysis-stat>b{float:right;font-size:17px}.analysis-stat>i{display:block;height:8px;background:#edf1f7;border-radius:5px;overflow:hidden;margin-top:9px}.analysis-stat em{display:block;height:100%;background:#4c72e8;border-radius:5px;transition:width .35s}.analysis-stat i.warm em{background:#f59e0b}.analysis-note{font-size:10px;color:#8b94a6;background:#f7f8fb;border-radius:8px;padding:9px}.analysis-bar{margin-top:17px}.analysis-bar label{display:flex;justify-content:space-between;font-size:10px;color:#687386;margin-bottom:7px}.analysis-bar label b{color:#303a50}.analysis-bar>i{height:8px;display:block;background:#edf1f7;border-radius:5px;overflow:hidden}.analysis-bar em{height:100%;display:block;border-radius:5px}.station-analysis{padding-bottom:8px}.analysis-table{overflow:auto}.analysis-row{display:grid;grid-template-columns:2fr .8fr .8fr 1.1fr 1.1fr .7fr;gap:12px;align-items:center;border-top:1px solid #eef0f4;padding:12px 4px;font-size:10px;color:#606b7f}.analysis-row strong{color:#303a50}.analysis-row strong small{display:block;font-weight:400;color:#99a2b1;margin-top:4px}.analysis-head{border-top:0;color:#9aa3b1;font-size:9px;padding-top:0}.status-good{color:#16975a}.status-bad{color:#df514b}@media(max-width:1100px){.analytics-grid{grid-template-columns:1fr}}

.report-secret{opacity:.12;font-size:9px;padding:5px 7px;border:0;color:#fff;background:transparent}.analytics-intro:hover .report-secret,.report-secret:focus{opacity:1;background:#ffffff20;color:#fff}.report-page{display:grid;gap:16px}.report-toolbar{display:flex;justify-content:space-between}.report-document{background:#fff;border:1px solid #e3e7ef;border-radius:15px;padding:28px;box-shadow:0 3px 12px #24324c08}.report-document>header{border-bottom:1px solid #edf0f4;padding-bottom:20px}.report-document h2{font-size:22px;margin-top:8px}.report-document header p{font-size:11px;color:#8d96a8;margin-top:7px}.report-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0 28px}.report-summary div{background:#f7f8fb;border-radius:10px;padding:14px}.report-summary b,.report-summary span{display:block}.report-summary b{font-size:25px;color:#303a50}.report-summary span{font-size:10px;color:#8b94a6;margin-top:4px}.report-document h3{font-size:14px;margin:24px 0 10px;color:#40506a}.report-item{border:1px solid #eef0f4;border-radius:9px;padding:11px 13px;margin:7px 0}.report-item strong{font-size:11px;color:#303a50}.report-item span{float:right;font-size:9px;color:#df514b}.report-item p,.report-empty,.report-advice{font-size:11px;color:#697489;margin-top:6px}.report-advice{background:#edf3ff;padding:12px;border-radius:8px;color:#315fd6}

/* Unified page sizing and responsive layout */
:root{--content-max:1500px;--page-gap:16px}main{width:100%;max-width:none;padding:28px 32px 50px}main>header,main>.panel,main>.welcome-dashboard,main>.metrics,main>.section-title,main>.station-grid,main>.station-pagination,main>.analytics-page,main>.report-page{width:min(100%,var(--content-max));margin-left:auto;margin-right:auto}.panel,.fsm-monitor,.analytics-intro,.analysis-card,.report-document{border-radius:14px}.panel{min-height:560px}.toolbar,.alarm-actions{min-height:58px}.welcome-dashboard,.analytics-page,.report-page{gap:var(--page-gap)}
@media(max-width:1250px){body{min-width:0}.sidebar{width:210px}main{margin-left:210px;padding:22px 20px 36px}.header-actions{flex-wrap:wrap;justify-content:flex-end}.welcome-hero{padding:28px 30px}.hero-radar{margin-left:30px;margin-right:20px}}
@media(max-width:850px){.sidebar{position:static;width:100%;height:auto;min-height:0;padding:14px}.brand{padding-bottom:14px}.sidebar nav{grid-template-columns:repeat(3,1fr)}.sidebar nav button{justify-content:center;padding:10px 8px;font-size:12px}.sidebar nav button b{right:4px;top:5px;transform:none}.side-status{display:none}main{margin-left:0;padding:18px 14px 28px}main>header{align-items:flex-start;gap:12px;flex-direction:column}.header-actions{width:100%;justify-content:flex-start}.header-actions .access-action{display:none}.metrics{grid-template-columns:repeat(2,1fr)}.welcome-hero{min-height:0}.hero-radar{display:none}.welcome-charts,.analytics-grid{grid-template-columns:1fr}.report-summary{grid-template-columns:1fr}.panel{min-height:480px}.toolbar{flex-wrap:wrap}.toolbar>span{margin-left:0}.fsm-monitor{height:calc(100vh - 190px)}.fsm-monitor>header{flex-wrap:wrap}.fsm-monitor select{min-width:0;flex:1}}

/* Wide screens: use the available content area instead of leaving side gutters */
html,body,#root{max-width:100%;overflow-x:hidden}main>header,main>.panel,main>.welcome-dashboard,main>.metrics,main>.section-title,main>.station-grid,main>.station-pagination,main>.analytics-page,main>.report-page{width:100%;max-width:none}.fsm-monitor{width:100%;max-width:none}.welcome-station-grid{grid-template-columns:repeat(5,minmax(0,1fr))}@media(max-width:1350px){.welcome-station-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:1100px){.welcome-station-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:850px){.welcome-station-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.welcome-station-grid{grid-template-columns:1fr}}
.internet.needs-refresh{border-color:#e59b31;background:#fff8e8;color:#a35d08}.internet-warning{width:16px;height:16px;border-radius:50%;background:#e59b31;color:#fff;font-size:11px;line-height:16px}.internet.needs-refresh:hover{background:#fff0d4}

/* Keep main content inside the viewport beside the fixed sidebar */
main{width:calc(100% - 228px);min-width:0}main>*{min-width:0}@media(max-width:1250px){main{width:calc(100% - 210px)}}@media(max-width:850px){main{width:100%;margin-left:0}}
